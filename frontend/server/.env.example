# IntellMeet - Environment Configurations

# Node Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB Atlas or Local MongoDB)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/intellmeet?retryWrites=true&w=majority
# Fallback local connection:
# MONGO_URI=mongodb://127.0.0.1:27017/intellmeet

# Authentication Secrets
JWT_SECRET=your_jwt_signing_secret_key_here

# OpenAI Integration API Keys (AI Meeting Summaries)
# Optional: if left blank, backend will fall back to local rule-based summary generator
OPENAI_API_KEY=your_openai_api_key_here
